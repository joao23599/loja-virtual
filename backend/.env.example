PORT=3000
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Banco de dados: PostgreSQL (padrão deste arquivo). Para MySQL veja .env.mysql.example
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=loja
DB_USER=postgres
DB_PASS=postgres

JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1d

# pasta (relativa à raiz do backend) onde as imagens enviadas ficam salvas
MEDIA_DIR=media
